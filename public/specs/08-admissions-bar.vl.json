{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 900,
  "background": "transparent",
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#56636d",
      "titleColor": "#56636d",
      "gridColor": "#e7e4de",
      "domain": false,
      "tickColor": "#d6d3cb",
      "labelPadding": 9,
      "titlePadding": 15
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#56636d",
      "titleColor": "#56636d",
      "orient": "top",
      "direction": "horizontal",
      "title": null
    },
    "text": {
      "font": "DM Sans"
    }
  },
  "height": 260,
  "data": {
    "values": [
      {
        "provider": "MOH hospitals",
        "admissions": 2579373,
        "year": 2024,
        "coverage": "97.94% MOH submission",
        "value": 2579373
      },
      {
        "provider": "Private-sector providers",
        "admissions": 1359910,
        "year": 2024,
        "coverage": "82.33% private response",
        "value": 1359910
      },
      {
        "provider": "Other government hospitals",
        "admissions": 197530,
        "year": 2024,
        "coverage": "Separate non-MOH returns",
        "value": 197530
      },
      {
        "provider": "MOH special institutions",
        "admissions": 133543,
        "year": 2024,
        "coverage": "97.94% MOH submission",
        "value": 133543
      }
    ]
  },
  "encoding": {
    "y": {
      "field": "provider",
      "type": "nominal",
      "sort": [
        "MOH hospitals",
        "Private-sector providers",
        "Other government hospitals",
        "MOH special institutions"
      ],
      "axis": {
        "title": null,
        "ticks": false,
        "labelFontSize": 12,
        "labelLimit": 200,
        "labelExpr": "datum.label === 'Other government hospitals' ? 'Other govt.' : datum.label === 'Private-sector providers' ? 'Private providers' : datum.label === 'MOH special institutions' ? 'MOH special inst.' : datum.label"
      }
    },
    "x": {
      "field": "value",
      "type": "quantitative",
      "scale": {
        "domain": [
          0,
          3200000
        ]
      },
      "axis": {
        "title": "Reported admission episodes",
        "format": "~s",
        "tickCount": 5
      }
    },
    "tooltip": [
      {
        "field": "provider",
        "title": "Provider group"
      },
      {
        "field": "admissions",
        "format": ",",
        "title": "Reported admissions"
      },
      {
        "field": "coverage",
        "title": "Reporting coverage"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 26,
        "cornerRadiusEnd": 2
      },
      "encoding": {
        "color": {
          "field": "provider",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "MOH hospitals",
              "Private-sector providers",
              "Other government hospitals",
              "MOH special institutions"
            ],
            "range": [
              "#f36c4f",
              "#e8b44e",
              "#4b8294",
              "#9fc6ae"
            ]
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 13,
        "color": "#172B42"
      },
      "encoding": {
        "text": {
          "field": "value",
          "format": ","
        }
      }
    }
  ],
  "params": [
    {
      "name": "hoveredState",
      "value": ""
    }
  ],
  "usermeta": {
    "export": {
      "generator": "admissionsBarChartSpec",
      "arguments": [
        900,
        false
      ],
      "chartId": "admissions",
      "note": "Count/share toggle requires React. Hover emphasis is driven by the website; hoveredState starts empty. Tooltip definitions are retained. Width is a fixed snapshot; page layout and fonts are supplied by the host."
    }
  }
}

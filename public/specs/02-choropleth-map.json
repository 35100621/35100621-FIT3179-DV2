{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 900,
  "background": "transparent",
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#56636d",
      "titleColor": "#56636d",
      "gridColor": "#e7e4de",
      "domain": false,
      "tickColor": "#d6d3cb",
      "labelPadding": 9,
      "titlePadding": 15
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#56636d",
      "titleColor": "#56636d",
      "orient": "top",
      "direction": "horizontal",
      "title": null
    },
    "text": {
      "font": "DM Sans"
    }
  },
  "height": 360,
  "data": {
    "url": "../data/states.geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },
  "projection": {
    "type": "mercator"
  },
  "mark": {
    "type": "geoshape",
    "stroke": "#fffefa",
    "strokeWidth": 0.8
  },
  "encoding": {
    "color": {
      "field": "properties.rate",
      "type": "quantitative",
      "scale": {
        "type": "threshold",
        "domain": [12, 15, 20, 30],
        "range": ["#e2eeeb", "#b7d1cb", "#7fa99f", "#527f78", "#172b42"]
      },
      "legend": {
        "orient": "bottom",
        "title": "Public beds per 10,000 residents",
        "titleLimit": 300,
        "labelExpr": "datum.label",
        "symbolType": "square"
      }
    },
    "opacity": {
      "condition": [
        {
          "test": "datum.properties.state === hoveredState || datum.properties.state === selectedState",
          "value": 1
        },
        {
          "test": "hoveredState !== ''",
          "value": 0.65
        }
      ],
      "value": {
        "expr": "selectedState ? 0.6 : 1"
      }
    },
    "stroke": {
      "condition": {
        "test": "datum.properties.state === hoveredState || datum.properties.state === selectedState",
        "value": "#f36c4f"
      },
      "value": "#fffefa"
    },
    "strokeWidth": {
      "condition": {
        "test": "datum.properties.state === hoveredState || datum.properties.state === selectedState",
        "value": 2.8
      },
      "value": 0.8
    },
    "tooltip": [
      {
        "field": "properties.state",
        "title": "State / federal territory"
      },
      {
        "field": "properties.rate",
        "format": ".2f",
        "title": "Public beds / 10,000"
      },
      {
        "field": "properties.beds",
        "format": ",",
        "title": "Public beds"
      },
      {
        "field": "properties.residents",
        "format": ",",
        "title": "Residents (2024)"
      }
    ]
  },
  "params": [
    {
      "name": "hoveredState",
      "value": ""
    },
    {
      "name": "selectedState",
      "value": ""
    },
    {
      "name": "containerWidth",
      "value": 900
    },
    {
      "name": "region",
      "value": "All Malaysia"
    }
  ],
  "usermeta": {
    "chartId": "choropleth",
    "responsive": [
      {
        "maxWidth": 499,
        "set": {
          "/height": 300
        }
      }
    ],
    "description": "Canonical editable Vega-Lite specification. Controls update declared parameters; responsive settings are applied by the generic host."
  },
  "transform": [
    {
      "filter": "region === 'All Malaysia' || (indexof(['Sabah','Sarawak','W.P. Labuan'], datum.properties.state) >= 0) === (region === 'East Malaysia')"
    }
  ]
}

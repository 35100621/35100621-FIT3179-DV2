{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 900,
  "background": "transparent",
  "autosize": {
    "type": "fit-x",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "font": "DM Sans",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": "normal",
      "labelColor": "#d3dde4",
      "titleColor": "#d3dde4",
      "gridColor": "#435568",
      "domain": false,
      "tickColor": "#3b5155",
      "labelPadding": 9,
      "titlePadding": 15
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#c6d5d2",
      "titleColor": "#c6d5d2",
      "orient": "top",
      "direction": "horizontal",
      "title": null
    },
    "text": {
      "font": "DM Sans"
    }
  },
  "height": 210,
  "data": {
    "url": "../data/ageing.json"
  },
  "encoding": {
    "x": {
      "field": "share",
      "type": "quantitative",
      "scale": {
        "domain": [0, 10]
      },
      "axis": {
        "title": "Share of resident population aged 65+ (%)",
        "tickCount": 6
      }
    },
    "y": {
      "field": "year",
      "type": "ordinal",
      "axis": {
        "title": null,
        "labelFontSize": 16,
        "ticks": false
      }
    },
    "tooltip": [
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "share",
        "format": ".2f",
        "title": "Population aged 65+ (%)"
      },
      {
        "field": "older_residents",
        "format": ",",
        "title": "Residents aged 65+"
      },
      {
        "field": "residents",
        "format": ",",
        "title": "Total residents"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": 34,
        "cornerRadiusEnd": 2
      },
      "encoding": {
        "color": {
          "field": "year",
          "type": "nominal",
          "scale": {
            "domain": [2015, 2024],
            "range": ["#e8b44e", "#D77750"]
          },
          "legend": null
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "color": "#ffffff",
        "fontSize": 18,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "share",
          "format": ".2f"
        }
      }
    }
  ],
  "params": [
    {
      "name": "hoveredState",
      "value": ""
    },
    {
      "name": "selectedState",
      "value": ""
    },
    {
      "name": "containerWidth",
      "value": 900
    }
  ],
  "usermeta": {
    "chartId": "ageing",
    "responsive": [],
    "description": "Canonical editable Vega-Lite specification. Controls update declared parameters; responsive settings are applied by the generic host."
  }
}
